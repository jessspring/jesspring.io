@model int
@{
    Layout = "WatchBase";
    var streamUrl = $"https://vsrc.su/embed/movie?tmdb={Model}&ds_lang=en";
}

<div class="card">
    <iframe src="@streamUrl" style="width: 960px; height: 560px;" frameborder="0" referrerpolicy="origin" allowfullscreen></iframe>
</div>

<div class="card title-card">
    <div class="flex fd-column gap-10">
        <img class="title-image" id="title-image" />
        <a href="@streamUrl" class="button button-fit" target="_blank">Open in new tab ></a>
    </div>

    <div class="flex fd-column w-100">
        <div class="card blue-card title-info">
            <div>
                <div class="pixel-font-bold title-name" id="title-name"></div>
                <div id="title-date"></div>
            </div>
        </div>

        <div class="card yellow-card title-description" id="title-description"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.data = { movieId: "@Model" };
    </script>

    <script src="/scripts/jessflix/watchMovie.js" asp-append-version="true"></script>
}
